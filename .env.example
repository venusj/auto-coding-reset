# ==========================================================
# auto-coding-reset 环境变量示例
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，请勿提交。
# ==========================================================

# ---- 智谱 GLM Coding Plan ----
# 在智谱开放平台获取的 Coding Plan 专属 API Key
ZHIPU_API_KEY=

# ---- MiniMax Token Plan ----
# 形如 sk-tp-... 的 Token Plan 专属 API Key
MINIMAX_API_KEY=

# ---- 应用配置 ----
# 可选：指定配置文件路径，默认为 ./config.yaml
# APP_CONFIG=config.yaml

# ---- 告警 webhook（可选）----
# 支持 Server酱 / 钉钉 / 飞书 / 自定义 webhook
# NOTIFY_WEBHOOK_URL=
